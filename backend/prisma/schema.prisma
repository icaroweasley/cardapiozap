generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Merchant {
  id               String    @id @default(uuid())
  name             String
  slug             String    @unique
  phone            String
  password         String
  whatsappProvider String    @default("EVOLUTION") // "EVOLUTION" or "OFFICIAL"
  whatsappConfig   String?   // JSON string for credentials
  logoUrl          String?
  deliveryFee      Int       @default(0) // cents
  minOrderValue    Int       @default(0) // cents
  businessHours    String?   // JSON
  address          String?
  paymentMethods   String?   // JSON
  active           Boolean   @default(true)
  isAdmin          Boolean   @default(false)
  isTrial          Boolean   @default(true)
  accountType      String    @default("FULL") // "FULL" or "BROADCAST_ONLY"
  subscriptionPrice Float    @default(49.90)
  planStatus       String    @default("active") // "active", "inactive"
  planExpiresAt    DateTime? 
  createdAt        DateTime  @default(now())
  products         Product[]
  orders           Order[]
  savedLists       SavedList[]

  @@index([slug])
}

model SavedList {
  id          String   @id @default(uuid())
  merchantId  String
  name        String
  contacts    String   // JSON string of contacts
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  merchant    Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  @@index([merchantId])
}

model Product {
  id          String      @id @default(uuid())
  merchantId  String
  name        String
  description String?
  price       Int         // Store in cents
  imageUrl    String?
  category    String
  available   Boolean     @default(true)
  merchant    Merchant    @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  orderItems  OrderItem[]
  optionGroups ProductOptionGroup[]

  @@index([merchantId])
}

model ProductOptionGroup {
  id          String      @id @default(uuid())
  productId   String
  name        String
  required    Boolean     @default(false)
  minChoices  Int         @default(0)
  maxChoices  Int         @default(1)
  product     Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  options     ProductOption[]

  @@index([productId])
}

model ProductOption {
  id          String             @id @default(uuid())
  groupId     String
  name        String
  price       Int                @default(0) // cents
  group       ProductOptionGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@index([groupId])
}

model Order {
  id             String      @id @default(uuid())
  merchantId     String
  customerName   String
  customerPhone  String
  deliveryType   String      // "DELIVERY" or "PICKUP"
  address        String?
  paymentMethod  String
  totalAmount    Int         // Store in cents
  status         String      @default("PENDING") // "PENDING", "PREPARING", "SHIPPED", "FINISHED"
  observation    String?

  createdAt      DateTime    @default(now())
  merchant       Merchant    @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  items          OrderItem[]

  @@index([merchantId])
}

model OrderItem {
  id              String   @id @default(uuid())
  orderId         String
  productId       String
  quantity        Int
  priceAtPurchase Int      // Store in cents
  options         String?  // JSON string array of { name, price }
  order           Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product         Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([productId])
}
